[Unit]
Description=Archub Gunicorn Service
Wants=network-online.target
After=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/archub
EnvironmentFile=/opt/archub/.env
Environment="FLASK_ENV=production"
Environment="TRUST_PROXY_HEADERS=true"
ExecStart=/opt/archub/venv/bin/gunicorn -c /opt/archub/hosting/gunicorn.conf.py hosting.wsgi:application
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
PrivateTmp=true
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
